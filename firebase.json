{
  "hosting": {
    "site": "codesentry-260311-9f2b",
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/auth/callback",
        "destination": "/index.html"
      },
      {
        "source": "/auth{,/**}",
        "run": {
          "serviceId": "codesentry-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/api{,/**}",
        "run": {
          "serviceId": "codesentry-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "codesentry-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
