# GitHub Service — Environment Variables
# Most vars are inherited from the root .env file.
# Only set overrides here for standalone (non-docker) development.

PORT=3002
NODE_ENV=development

# Override these only if running outside docker-compose:
# DATABASE_URL=postgresql://dev:devpass123@localhost:5432/codesentry

# WEBHOOK_SECRET is auto-mapped from GITHUB_WEBHOOK_SECRET in root .env.
# GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_SERVICE_INTERNAL_SECRET,
# and EMAIL_* vars are all loaded from the root .env file automatically.
