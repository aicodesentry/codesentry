# Analysis Service — Environment Variables
# All vars come from docker-compose env injection (reads root .env).
# For standalone runs, export vars or source the root .env manually:
#   export $(grep -v '^#' ../../.env | xargs)

PORT=8001
FRONTEND_URL=http://localhost:5173

# Optional — service degrades gracefully if unset
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=
MONGODB_URL=
ANALYSIS_STORE_IN_MONGO=true
ANALYSIS_CACHE_TTL_DAYS=7
