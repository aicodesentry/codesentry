{
  "name": "codesentry-api",
  "version": "1.0.0",
  "description": "CodeSentry API service - security review control plane",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint \"src/**/*.js\"",
    "test": "NODE_ENV=test jest --detectOpenHandles --forceExit",
    "db:migrate": "node src/scripts/runMigrations.js",
    "db:verify": "node src/scripts/verifyMigrations.js"
  },
  "type": "commonjs",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "axios": "^1.17.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "google-protobuf": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "prom-client": "^15.1.2"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
