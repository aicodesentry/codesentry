# API Service — Environment Variables
# Most vars are inherited from the root .env file.
# Only set overrides here for standalone (non-docker) development.

PORT=3000
NODE_ENV=development

# Override these only if running outside docker-compose:
# DATABASE_URL=postgresql://dev:devpass123@localhost:5432/codesentry
# ANALYSIS_SERVICE_URL=http://localhost:8001
# GITHUB_SERVICE_URL=http://localhost:3002

# Optional queue tuning:
# ANALYSIS_QUEUE_CONCURRENCY=1
# ANALYSIS_QUEUE_POLL_INTERVAL_MS=5000
# ANALYSIS_QUEUE_STALE_MINUTES=20

# All other vars (JWT_SECRET, GITHUB_*, ENCRYPTION_KEY, etc.)
# are loaded from the root .env file automatically.
